<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Real providers + streaming (Phase 13): HTTP metadata search and remote audio. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Background media playback (Phase 9). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Equalizer / audio effects (Phase 15). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      Downloads (offline listening). Keeps a batch alive when the user leaves the app.
      Downloads themselves live in app-private external storage — no permission at any API level.
      Publishing a copy to Music/Rizx needs nothing on API 29+ (scoped storage: inserting an entry
      this app owns is permission-free); on 26–28 the file must be written into the real public
      Music/ directory, which WRITE_EXTERNAL_STORAGE (requested at the save-to-phone opt-in UI)
      still guards there. The attribute caps it: from API 29 on it is not even requested.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
      Local music player: read the device's own audio library (MediaStore.Audio). On API 33+ that is
      READ_MEDIA_AUDIO; below 33 the same gate is the legacy READ_EXTERNAL_STORAGE. Requested at
      runtime, contextually, when the user opens the Local library; denial is non-fatal.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      Music recognition. Requested only when the user starts a recognition — never at launch — and the
      captured audio is fingerprinted in memory and discarded: nothing is written to storage and no
      recording is ever sent anywhere. There is no foreground service and no always-on listening; the
      microphone is open only while the recognition screen is in front of the user.
      `required="false"` keeps the app installable on the (rare) device with no microphone at all,
      where the screen says so instead of failing.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:name=".RizxApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rizx">

        <!-- singleTask: a share link opened while Rizx is running lands in onNewIntent of the live
             activity instead of stacking a second one with its own player UI. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Rizx.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share links: https://<share host><share path>/<token>. Host and path come from
                 RIZX_SHARE_BASE_URL at build time. autoVerify makes this an App Link — opened straight
                 in Rizx, no chooser, no browser — once the share host serves
                 /.well-known/assetlinks.json (see share-site/). Until then Android 8–11 offer a chooser
                 and Android 12+ let the user enable it under App info › Open by default. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${shareLinkHost}"
                    android:pathPrefix="${shareLinkPath}" />
            </intent-filter>

            <!-- rizx://share/<token>: the app's own scheme. Needs no domain verification — it is what the
                 browser landing page's "Open in Rizx" button fires. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rizx" android:host="share" />
            </intent-filter>
        </activity>

        <!-- Owns the single ExoPlayer, the MediaSession, and the media notification. -->
        <service
            android:name=".playback.service.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Holds the process while songs are being saved for offline listening. -->
        <service
            android:name=".data.download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Home screen widgets (widget/): the Now Playing card and its compact row. The launcher's
             update broadcast is a protected system action, which is why these are exported. -->
        <receiver
            android:name=".widget.NowPlayingCardWidget"
            android:exported="true"
            android:label="@string/widget_card_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_playing_card_info" />
        </receiver>
        <receiver
            android:name=".widget.NowPlayingBarWidget"
            android:exported="true"
            android:label="@string/widget_bar_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_playing_bar_info" />
        </receiver>
        <receiver
            android:name=".widget.AudioIdWidget"
            android:exported="true"
            android:label="@string/widget_audio_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_audio_id_info" />
        </receiver>
        <!-- The widgets' buttons: explicit intents from our own PendingIntents only. -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>
</manifest>
