<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Real providers + streaming (Phase 13): HTTP metadata search and remote audio. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Background media playback (Phase 9). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Equalizer / audio effects (Phase 15). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      Downloads (offline listening). Keeps a batch alive when the user leaves the app.
      Downloads themselves live in app-private external storage — no permission at any API level.
      Publishing a copy to Music/Rizx needs nothing on API 29+ (scoped storage: inserting an entry
      this app owns is permission-free); on 26–28 the file must be written into the real public
      Music/ directory, which WRITE_EXTERNAL_STORAGE (requested at the save-to-phone opt-in UI)
      still guards there. The attribute caps it: from API 29 on it is not even requested.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
      Local music player: read the device's own audio library (MediaStore.Audio). On API 33+ that is
      READ_MEDIA_AUDIO; below 33 the same gate is the legacy READ_EXTERNAL_STORAGE. Requested at
      runtime, contextually, when the user opens the Local library; denial is non-fatal.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".RizxApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rizx">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Rizx.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Owns the single ExoPlayer, the MediaSession, and the media notification. -->
        <service
            android:name=".playback.service.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Holds the process while songs are being saved for offline listening. -->
        <service
            android:name=".data.download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
