<?xml version="1.0" encoding="utf-8"?>
<!--
  Ivory logomark for the Android 12+ *system* splash, which covers the ~2s of cold start before Compose
  draws its first frame. That slot is masked to a circle, so it can only hold the bare symbol — the
  complete "logomark + Rizx." lockup is drawn afterwards by RizxSplash. Leaving this blank was tried and
  reverted: it left the whole cold start as an empty black screen.

  Sized so the mark sits well inside the circular mask (nothing is clipped). Same geometry as
  ic_launcher_foreground; see that file for how the mark is constructed.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="25.5"
        android:translateY="21"
        android:scaleX="0.228"
        android:scaleY="0.228">

        <!-- Stem; its right edge follows the counter circle so the bowl reads as negative space. -->
        <path
            android:fillColor="#F3ECE2"
            android:pathData="M0,39 L104,39 L104,83.08 A56,56 0 0,0 77,189.6 L77,278 L67,289 L0,289 Z" />

        <path
            android:fillColor="#F3ECE2"
            android:pathData="M78,139 A23,23 0 1,0 124,139 A23,23 0 1,0 78,139 Z" />

        <path
            android:strokeColor="#F3ECE2"
            android:strokeWidth="26"
            android:trimPathStart="0.03"
            android:trimPathEnd="0.402"
            android:pathData="M101,70 A69,69 0 0,1 101,208 A69,69 0 0,1 101,70 Z" />

        <path
            android:strokeColor="#F3ECE2"
            android:strokeWidth="29"
            android:trimPathStart="0.017"
            android:trimPathEnd="0.243"
            android:pathData="M101,14.5 A124.5,124.5 0 0,1 101,263.5 A124.5,124.5 0 0,1 101,14.5 Z" />

        <path
            android:strokeColor="#F3ECE2"
            android:strokeWidth="29"
            android:trimPathStart="0.257"
            android:trimPathEnd="0.369"
            android:pathData="M101,14.5 A124.5,124.5 0 0,1 101,263.5 A124.5,124.5 0 0,1 101,14.5 Z" />

        <path
            android:fillColor="#F3ECE2"
            android:pathData="M94,200 L153,200 L222,289 L163,289 Z" />

        <path
            android:fillColor="#FB4312"
            android:pathData="M200,244 L215,244 L249,289 L234,289 Z" />
    </group>
</vector>
