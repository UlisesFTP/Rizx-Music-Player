<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup / transfer rules for Android 12+ (API 31+). Same intent as backup_rules.xml: keep plugin
  credentials (filesDir/plugins/<id>/settings.json|storage.json — a token, a username, in plaintext) out
  of both cloud backup and device-to-device transfer. Favorites, playlists and the playback session
  still restore. Plugins are reinstalled rather than restored.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="plugins" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="plugins" />
    </device-transfer>
</data-extraction-rules>
