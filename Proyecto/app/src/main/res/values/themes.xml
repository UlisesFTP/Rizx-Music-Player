<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Bare NoActionBar framework theme. The real look comes from Compose (RizxTheme);
      this only governs the window before the first frame. Bars are transparent so the
      Activity can draw edge-to-edge (enableEdgeToEdge()).

      Version-specific window attributes layer on top of this base by redeclaring the derived styles
      in values-v28/ (display cutout, API 28 attr) and values-v31/ (system splash, API 31 attrs).
      What's below is exactly what an API 26–27 device runs with.
    -->
    <style name="Base.Theme.Rizx" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/rizx_window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Rizx" parent="Base.Theme.Rizx" />

    <!--
      Launch theme. On API 31+ the system draws a splash screen whose attributes live in
      values-v31/themes.xml (the windowSplashScreen* attributes don't exist before 31). Below 31 a
      cold start simply shows the themed window background — the same dark field — until Compose's
      first frame, and RizxSplash then presents the full lockup. Deliberately no
      androidx.core:core-splashscreen: the pre-31 experience is acceptable without a new dependency.
    -->
    <style name="Theme.Rizx.Splash" parent="Theme.Rizx" />
</resources>
